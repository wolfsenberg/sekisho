# The Go service reads process environment, not .env files automatically.
SEKISHO_ADDR=127.0.0.1:8080
SEKISHO_DATA_DIR=./data
# Optional existing/private credential key outside SEKISHO_DATA_DIR; unset keeps data/credentials.key.
# Move the existing key before enabling this for an initialized instance.
# SEKISHO_CREDENTIALS_KEY_FILE=/secure/sekisho/credentials.key
SEKISHO_LOG_LEVEL=info
# Optional instance-wide encrypted backups; ignored in demo mode.
# Use a private directory (0700) dedicated to this instance; the password file must be private (0600).
# Keep the independent 12–128 character password outside the backup directory and data directory.
# Runs at startup, then waits the interval after each attempt. No remote uploads.
# SEKISHO_BACKUP_DIR=/srv/sekisho-backups
# SEKISHO_BACKUP_PASSWORD_FILE=/secure/sekisho/backup-password
# SEKISHO_BACKUP_INTERVAL=24h
# SEKISHO_BACKUP_KEEP=7
# Optional instance-level failure webhook; public HTTPS only, separate from workspace alerts.
# SEKISHO_BACKUP_WEBHOOK_URL=https://hooks.example.com/sekisho-backups
# Read-only demo with public demo / sekisho-demo login. Uses disposable temporary data;
# ignores SEKISHO_DATA_DIR and all pricing paths. No live provider requests.
SEKISHO_DEMO=false
# Model request and reconstructed WebSocket context limit in MiB; responses/events remain 8 MiB.
SEKISHO_MAX_REQUEST_BODY_MB=128
# Per-workspace runtime policy. Restart/recreate the service after changing these.
# SEKISHO_GATEWAY_CAPACITY=128
# Optional quota-weighted new-session rotation within the same provider and priority tier.
# Missing/stale/partial quotas retain equal rotation. Existing conversations stay bound.
# SEKISHO_GATEWAY_QUOTA_WEIGHTED=false
# SEKISHO_GATEWAY_QUEUE_LIMIT=100
# SEKISHO_GATEWAY_QUEUE_TIMEOUT=30s
# SEKISHO_GATEWAY_REQUEST_TIMEOUT=30m
# Optional upstream stream idle timeout; 0s disables it. SSE heartbeats do not reset it.
# SEKISHO_GATEWAY_STREAM_IDLE_TIMEOUT=0s
# SEKISHO_GATEWAY_KEEPALIVE_INTERVAL=10s
# Retry only explicit temporary HTTP rejections before a successful response; 0 disables retries.
# SEKISHO_GATEWAY_RETRIES=2
# SEKISHO_GATEWAY_RETRY_DELAY=500ms
# Transient failures affect only the selected model; threshold 0 disables this cooldown.
# SEKISHO_GATEWAY_TRANSIENT_THRESHOLD=3
# SEKISHO_GATEWAY_TRANSIENT_WINDOW=2m
# SEKISHO_GATEWAY_TRANSIENT_COOLDOWN=10s
# Fallback only; a real upstream Retry-After takes precedence.
# SEKISHO_GATEWAY_RATE_LIMIT_COOLDOWN=5s
# Inference response-header wait; 0s disables it. Metadata retains its shorter timeout.
# SEKISHO_INFERENCE_HEADER_TIMEOUT=5m
# On stop, in-flight requests get this long to finish before being canceled.
# Keep it below the container stop grace period (30s in docker.compose.yaml).
# SEKISHO_SHUTDOWN_TIMEOUT=20s
# When the container has a memory limit, set a Go soft limit about 20% below it.
# GOMEMLIMIT=400MiB
# Set the external origin when serving behind a reverse proxy.
# HTTPS origins enable Secure session cookies.
# SEKISHO_PUBLIC_URL=https://sekisho.example.com
# Trust only the CIDR addresses of your own reverse proxy; keep unset for direct access.
# SEKISHO_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Model price catalog (LiteLLM-compatible JSON; defaults to Sub2API's model-price-repo).
# Prices are cached locally and copied into new allocation revisions.
# SEKISHO_PRICING_URL=https://raw.githubusercontent.com/Wei-Shaw/model-price-repo/main/model_prices_and_context_window.json
# Set a matching hash URL with a custom price URL to retain SHA-256 verification.
# SEKISHO_PRICING_HASH_URL=https://raw.githubusercontent.com/Wei-Shaw/model-price-repo/main/model_prices_and_context_window.sha256
# SEKISHO_PRICING_CACHE=./data/model-prices.json
# SEKISHO_PRICING_FALLBACK=./data/model-prices.fallback.json
# SEKISHO_PRICING_OVERRIDE=./data/model-prices.override.json
# SEKISHO_PRICING_INTERVAL=6h

# Optional process-wide Prometheus endpoint, protected by its own bearer credential.
# Use a random 32–128 character visible ASCII token, different from gateway API keys.
# Configure Prometheus authorization credentials; never put the token in the scrape URL.
# SEKISHO_METRICS_TOKEN=

# Docker Compose interpolation only; these do not configure the Go process directly.
# Pin a version that has actually been published, or use a full image digest.
# SEKISHO_IMAGE=ghcr.io/wolfsenberg/sekisho:0.1.0
# SEKISHO_BIND_ADDRESS=127.0.0.1
# SEKISHO_PORT=8080
